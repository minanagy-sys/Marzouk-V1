# ── Hostinger / MySQL build — copy to .env and fill in ──────────────────────

# MySQL (from Hostinger → Databases → your MySQL DB)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name
# MYSQL_POOL_SIZE=8

# Admin session signing secret — use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=change_me_to_a_long_random_string

# Where uploaded images are stored + the URL they're served from.
# Keep UPLOAD_DIR on a persistent path OUTSIDE the build so images survive redeploys.
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_BASE=/uploads

# Public site URL (for canonical/sitemap/OpenGraph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Only needed to RUN the one-time migration from Supabase ─────────────────
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service_role_key_here
