# ── Hostinger / MySQL build — copy to .env and fill in ──────────────────────

# MySQL (from Hostinger → Databases → your MySQL DB)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name
# MYSQL_POOL_SIZE=8

# Admin session signing secret — use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=change_me_to_a_long_random_string

# Where uploaded images are stored + the URL they're served from.
# Keep UPLOAD_DIR on a persistent path OUTSIDE the app folder so images survive
# redeploys. On Hostinger use the absolute path to public_html/uploads, e.g.
#   UPLOAD_DIR=/home/uXXXXXXXX/domains/your-domain.com/public_html/uploads
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_BASE=/uploads
# Max upload size in MB (images are rejected above this). Default 5.
# MAX_UPLOAD_MB=5

# Public site URL (for canonical/sitemap/OpenGraph). MUST be your real https domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Force the admin cookie to be Secure (set true on the live HTTPS domain).
COOKIE_SECURE=true
# Optional default social-share image (absolute URL) used when a page has none.
# You can instead set it from Admin -> Site text -> SEO (seo.ogImage).
# NEXT_PUBLIC_OG_IMAGE=https://your-domain.com/uploads/og-default.jpg

# ── Only needed to RUN the one-time migration from Supabase ─────────────────
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service_role_key_here
